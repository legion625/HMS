<?page title="new page title" contentType="text/html;charset=UTF-8"?>
<?xel-method prefix="hms" name="ver" class="hms.web.zk.ResourceVersion" signature="java.lang.String of(java.lang.String)"?>
<zk>

	<!-- 本元件自帶樣式與行為；swipe.js 內有防重複綁定，多張卡片各載入一次也只會綁定一次 -->
	<!-- ?v= 為檔案最後修改時間，檔案更新後瀏覽器會自動重抓，不會沿用快取的舊檔 -->
	<style src="/css/swipe.css?v=${hms:ver('/css/swipe.css')}" />
	<script src="/js/swipe.js?v=${hms:ver('/js/swipe.js')}" />

	<div id="divSwipe" sclass="swipe-container" apply="hms.web.control.zk.common.SwipeDivComposer">
		<div id="divContent" sclass="swipe-content">
		</div>
		<!-- 先隱藏，等 swipe.css 載入後才顯示(見 swipe.css)；避免切換分頁時按鈕區先未套樣式露出、再滑出畫面的閃動 -->
		<div sclass="swipe-actions" style="display: none;">
			<button id="btnR1" sclass="swipe-action" />
			<button id="btnR2" sclass="swipe-action" />
		</div>
	</div>
</zk>
