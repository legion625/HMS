<?page title="new page title" contentType="text/html;charset=UTF-8"?>
<zk>

	<!-- swipe.css / swipe.js 由外層頁面(mobileHome.zul)載入一次，避免每張卡片重複載入 -->

	<div id="divSwipe" sclass="swipe-container" apply="hms.web.control.zk.common.SwipeDivComposer">
		<div id="divContent" sclass="swipe-content">
		</div>
		<div sclass="swipe-actions">
			<button id="btnR1" sclass="swipe-action" />
			<button id="btnR2" sclass="swipe-action" />
		</div>
	</div>
</zk>